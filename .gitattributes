# В репозитории переводы строк всегда LF: скрипты рабочего процесса
# GitHub Actions выполняются в Linux и не терпят символ возврата каретки.
* text=auto
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf
*.html text eol=lf
